# Copia este archivo como .env. Los tiempos estan en segundos salvo que se indique HH:MM.
# No guardes credenciales reales en Git. Reinicia el runtime despues de modificar el .env.

# Portal y acceso de respaldo para ejecuciones que no provienen de una orden.
TARGET_URL=
LOGIN_USERNAME=
LOGIN_PASSWORD=
LOGIN_DOCUMENT_TYPE=dni
# Clave del proveedor usado para resolver el CAPTCHA solo al reservar.
APIKEY_2CAPTCHA=

# Navegador y evidencias.
# true oculta Chromium; false permite verlo.
HEADLESS=false
# Omite imagenes, fuentes y otros recursos pesados cuando el flujo no los necesita.
BLOCK_HEAVY_ASSETS=true
# Reserva automaticamente al encontrar un cupo compatible.
AUTO_RESERVE=false
# Captura los fallos importantes y los resultados utiles, respectivamente.
SCREENSHOT_ON_ERROR=true
SCREENSHOT_ON_RELEVANT_RESULT=true
# Densidad de la captura; 2 mejora la lectura a costa de archivos mayores.
SCREENSHOT_DEVICE_SCALE_FACTOR=2
# Resolucion y captura de sesiones por cliente. Por privacidad, el flujo normal
# elimina la grabacion si no hubo una reserva confirmada.
CLIENT_VIDEO_WIDTH=1920
CLIENT_VIDEO_HEIGHT=1080
RECORD_CLIENT_SESSIONS=false
RECORD_CLIENT_VIDEO_FINAL_MP4=true
RECORD_CLIENT_VIDEO_DIR=videos/reservations
# custom respeta estas opciones; fast y diagnostic aplican perfiles predefinidos.
EVIDENCE_PROFILE=custom
LOG_LEVEL=INFO
# Dias que se conservan logs, capturas y otros artefactos antiguos.
CLEANUP_RETENTION_DAYS=14

# Flujo simple y politicas de error.
# Pausa tras un error inesperado general. No es la pausa por rechazo de CAPTCHA.
ERROR_BACKOFF_SECONDS=1800
# Pausa tras un rechazo real de CAPTCHA; 120 equivale a 2 minutos.
CAPTCHA_REJECTION_COOLDOWN_SECONDS=120
# Intentos de CAPTCHA dentro de un unico intento de reserva.
RESERVATION_CAPTCHA_MAX_ATTEMPTS=2
# CAPTCHA totales guardados por intento real. 1 conserva el flujo normal; si es mayor,
# los anteriores se guardan para entrenamiento y solo el ultimo se envia a 2Captcha.
RESERVATION_CAPTCHA_SAMPLE_LIMIT=1
# La suma HTML espera un valor aleatorio dentro de este rango antes de reservar.
# Despues de la espera se vuelven a validar seleccion, suma y campos protegidos.
RESERVATION_MATH_PRE_SUBMIT_DELAY_MIN_SECONDS=1
RESERVATION_MATH_PRE_SUBMIT_DELAY_MAX_SECONDS=2
# Ventana simple; 0 hace una sola revision. Los tres valores siguientes no gobiernan
# el toggle multi-cliente cuando OBSERVER_SITE_TOGGLE_ENABLED=true.
MONITOR_WINDOW_SECONDS=120
MONITOR_MAX_ATTEMPTS=4
MONITOR_INTERVAL_MIN_SECONDS=25
MONITOR_INTERVAL_MAX_SECONDS=35

# PostgreSQL y cifrado de credenciales de clientes.
APPOINTMENT_DATABASE_URL=
# Lista de claves Fernet. La primera cifra; las siguientes permiten rotar claves antiguas.
APPOINTMENT_CREDENTIAL_KEYS=
# Variables usadas por Docker Compose para su PostgreSQL local.
APPOINTMENT_POSTGRES_USER=appointment_bot
APPOINTMENT_POSTGRES_PASSWORD=
APPOINTMENT_POSTGRES_DB=appointment_bot
APPOINTMENT_POSTGRES_PORT=5432

# Worker continuo y cola.
# 0 en QUEUE_MAX_RESERVATIONS_PER_RUN permite continuar recorriendo la cola.
QUEUE_MAX_RESERVATIONS_PER_RUN=1
QUEUE_DELAY_MIN_SECONDS=5
QUEUE_DELAY_MAX_SECONDS=15
CONTINUOUS_WORKER_ENABLED=false
# Margen adicional para declarar estancado un worker sin progreso.
WORKER_PROGRESS_GRACE_SECONDS=55
SESSION_RETRY_DELAYS_SECONDS=10,30,60
# Hora Lima desde la cual no se inician consultas nuevas.
WORKER_DAILY_CUTOFF_TIME=18:00
# Hace una ultima revision de las ordenes listas al llegar a la hora de corte.
FINAL_READY_REVIEW_ENABLED=true

# Recordatorios de citas; el modo disabled/dry_run/live vive en PostgreSQL.
APPOINTMENT_REMINDERS_TIME=18:00
# Tiempo para que aparezca y termine primero el resumen diario de evidencias.
APPOINTMENT_REMINDERS_SUMMARY_GRACE_MINUTES=15
APPOINTMENT_REMINDERS_RECONCILE_SECONDS=60
# Pausa entre recordatorios y limite duro de trabajos generados por dia.
APPOINTMENT_REMINDERS_SEND_INTERVAL_SECONDS=5
APPOINTMENT_REMINDERS_DAILY_LIMIT=100

# Observer multi-cliente.
# Duracion maxima de una sesion observer. Si el toggle esta apagado, tambien se usan
# OBSERVER_MAX_ATTEMPTS y el rango OBSERVER_INTERVAL_MIN/MAX_SECONDS.
OBSERVER_SESSION_SECONDS=120
OBSERVER_MAX_ATTEMPTS=4
OBSERVER_INTERVAL_MIN_SECONDS=25
OBSERVER_INTERVAL_MAX_SECONDS=35
# Maximo de muestras CAPTCHA recogidas en observacion; nunca autoriza reservas.
OBSERVER_CAPTCHA_SAMPLE_LIMIT=5
# Numero de clientes activos que se cargan por bloque antes de volver a consultar la cola.
OBSERVER_ACTIVE_ORDER_LIMIT=2
# Cadena secuencial iniciada por cupos observados: hasta 10 clientes o 5 minutos.
OPPORTUNITY_HANDOFF_MAX_CANDIDATES=10
OPPORTUNITY_HANDOFF_MAX_SECONDS=300
# Rafaga deslizante estable: detector + un auxiliar.
OPPORTUNITY_BURST_MAX_SESSIONS=2
# Incluye al detector; 0 recorre toda la cola compatible mientras haya confirmaciones.
OPPORTUNITY_BURST_MAX_CLIENTS=0
# Solo admite nuevas sesiones durante cinco minutos; las ya iniciadas se reconcilian.
OPPORTUNITY_BURST_MAX_SECONDS=300
# El auxiliar hace un ciclo corto; una reserva iniciada siempre termina su reconciliacion.
OPPORTUNITY_BURST_SESSION_SECONDS=20
OPPORTUNITY_BURST_ATTEMPTS=5
OPPORTUNITY_BURST_RELOAD_PROBE_AFTER_ATTEMPT=3
# Tras un slot_lost explicito, reutiliza la misma sesion antes de cerrarla.
SLOT_LOST_REOBSERVATION_SECONDS=12
SLOT_LOST_REOBSERVATION_ATTEMPTS=5
# La recarga cuenta como una de las cinco lecturas y solo puede ocurrir una vez.
SLOT_LOST_REOBSERVATION_RELOAD_PROBE_AFTER_ATTEMPT=3
# Activa el ciclo seleccion vacia -> sede en cada consulta.
OBSERVER_SITE_TOGGLE_ENABLED=true
# Hace 15 consultas por usuario, con una espera aleatoria nueva entre 1 y 2 segundos.
OBSERVER_SITE_TOGGLE_ATTEMPTS=15
OBSERVER_SITE_TOGGLE_INTERVAL_MIN_SECONDS=1
OBSERVER_SITE_TOGGLE_INTERVAL_MAX_SECONDS=2
# Recarga una vez despues del intento indicado y luego continua el mismo ciclo.
OBSERVER_RELOAD_PROBE_AFTER_ATTEMPT=8
# Sede que el toggle vuelve a seleccionar.
OBSERVER_REQUIRED_SITE=LIMA-LA VICTORIA
# Franjas HH:MM-HH:MM separadas por coma; vacio permite operar todo el dia habil.
OBSERVER_HOT_WINDOWS=08:15-08:50,09:30-10:00,11:40-12:40,15:55-16:30
# Mantiene activa una franja durante este tiempo adicional cuando ya estaba trabajando.
OBSERVER_HOT_WINDOW_EXTENSION_SECONDS=900
# Espera aleatoria fuera de las franjas.
OUTSIDE_HOT_WINDOW_MIN_SECONDS=1200
OUTSIDE_HOT_WINDOW_MAX_SECONDS=2400
# N vacios consecutivos activa recuperacion; 0 desactiva esta politica.
UNAVAILABLE_STREAK_LIMIT=8
RECOVERY_BACKOFF_MIN_SECONDS=1800
RECOVERY_BACKOFF_MAX_SECONDS=3600

# Limites de espera de operaciones web.
LOGIN_TIMEOUT_SECONDS=60
POSTBACK_TIMEOUT_SECONDS=30
READ_TIMEOUT_SECONDS=15
RESERVATION_TIMEOUT_SECONDS=180

# API local y panel. Usa 127.0.0.1 si solo se accede desde esta computadora.
APPOINTMENT_BOT_API_HOST=127.0.0.1
APPOINTMENT_BOT_API_PORT=8765
# Permite apagar reversiblemente la API embebida del worker tras retirar consumidores.
WORKER_EMBEDDED_API_ENABLED=true
# Obligatorio si la API se expone fuera de localhost.
APPOINTMENT_BOT_API_TOKEN=
# Permite sesiones manuales iniciadas desde el panel.
MANUAL_SESSION_ENABLED=false

# Telegram.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true tambien envia avisos cuando una revision no encuentra cupos.
TELEGRAM_NOTIFY_UNAVAILABLE=false
# Modelo CAPTCHA local en sombra: solo mide, nunca decide una reserva.
CAPTCHA_SHADOW_ENABLED=false
# Carga V3/V6 en CUDA mediante el supervisor local. Mantener apagado en reserva fria.
CAPTCHA_SHADOW_SERVICE_ENABLED=false
CAPTCHA_SHADOW_URL=http://127.0.0.1:8787
CAPTCHA_SHADOW_QUEUE_SIZE=100
CAPTCHA_SHADOW_TIMEOUT_SECONDS=2

# Infraestructura avanzada. Normalmente los lanzadores completan estas rutas y puertos.
# Directorio de trabajo comun del worker, Admin API y control Telegram.
APPOINTMENT_BOT_WORKDIR=
# Admin API separada del worker y publicacion opcional del dashboard compilado.
APPOINTMENT_BOT_ADMIN_API_HOST=127.0.0.1
APPOINTMENT_BOT_ADMIN_API_PORT=8766
APPOINTMENT_BOT_SERVE_DASHBOARD=true
APPOINTMENT_BOT_DASHBOARD_DIR=
# Control remoto: chats autorizados, API destino, timeout long-poll y offset durable.
TELEGRAM_CONTROL_CHAT_IDS=
TELEGRAM_CONTROL_USER_IDS=
TELEGRAM_CONTROL_ADMIN_API_URL=http://127.0.0.1:8766
TELEGRAM_CONTROL_POLL_TIMEOUT_SECONDS=25
TELEGRAM_CONTROL_OFFSET_PATH=
# Sustituye el monitor externo de n8n con revisiones autenticadas via Admin API.
TELEGRAM_WORKER_MONITOR_ENABLED=false
